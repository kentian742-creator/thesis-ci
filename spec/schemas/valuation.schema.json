{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/valuation.schema.json",
  "title": "Value ranges valuation.yml (private repository only)",
  "type": "object",
  "required": [
    "company",
    "as_of",
    "doc_status",
    "currency",
    "value_ranges",
    "discount_rate",
    "implied_return",
    "hurdles",
    "source",
    "method_note"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "doc_status": {
      "enum": [
        "proposed",
        "effective"
      ],
      "description": "proposed: a recalculated version awaiting review by 04C; effective: the version in force (§V20: only one version is in force at any time)"
    },
    "currency": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
      "description": "Source tag, TAG or TAG#LOCATOR"
    },
    "price_reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "type": "null"
        }
      ]
    },
    "value_ranges": {
      "type": "object",
      "required": [
        "center",
        "fair",
        "cheap"
      ],
      "properties": {
        "center": {
          "type": [
            "number",
            "null"
          ]
        },
        "fair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "cheap": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "error_band": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "description": "Error band [low, high]: an absolute range in the unit of center (not a relative proportion)"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
          "description": "Source tag, TAG or TAG#LOCATOR"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "margin_of_safety": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Margin-of-safety range [lower bound, upper bound], as decimals; default [0.25, 0.35] (§V2)"
    },
    "discount_rate": {
      "type": "object",
      "required": [
        "risk_free",
        "premium",
        "total"
      ],
      "properties": {
        "risk_free": {
          "type": [
            "number",
            "null"
          ]
        },
        "risk_free_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The date the 10-year US Treasury yield was read"
        },
        "premium": {
          "type": [
            "number",
            "null"
          ]
        },
        "total": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
          "description": "Source tag, TAG or TAG#LOCATOR"
        },
        "note": {
          "type": "string",
          "description": "The basis for the premium: which readings in this company's cash-flow record make it more predictable and which less (§V1, §V10)"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "total": {
                "type": "number"
              }
            },
            "required": [
              "total"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "implied_return": {
      "type": [
        "number",
        "null"
      ]
    },
    "hurdles": {
      "type": "object",
      "properties": {
        "brk": {
          "type": [
            "number",
            "null"
          ]
        },
        "voo": {
          "type": [
            "number",
            "array",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
          "description": "Source tag, TAG or TAG#LOCATOR"
        }
      },
      "additionalProperties": false
    },
    "comparable_anchor": {
      "type": "object",
      "required": [
        "value",
        "description",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "array",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
          "description": "Source tag, TAG or TAG#LOCATOR"
        }
      },
      "additionalProperties": false,
      "description": "The second reference anchor: the market-implied return of a comparable asset (§V6)"
    },
    "price_rating": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-E]$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Price grade, given by the mechanical scale of §V11, without a plus or minus sign"
    },
    "quality_rating": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-E][+−-]?0?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Business rating (on the same scale as ratings.business in thesis.yml)"
    },
    "method_note": {
      "type": "string"
    },
    "todo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "array",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
          "description": "Source tag, TAG or TAG#LOCATOR"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
