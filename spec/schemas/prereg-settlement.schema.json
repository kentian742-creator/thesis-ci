{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/prereg-settlement.schema.json",
  "title": "Pre-registration settlement prereg/<period>.settlement.yml (maintained by the pipeline)",
  "type": "object",
  "required": [
    "company",
    "period",
    "results"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "period": {
      "type": "string",
      "pattern": "^FY\\d{4}Q[1-4]$",
      "description": "The period in the company's fiscal year, FY<year>Q<quarter>"
    },
    "acceptance_datetime": {
      "type": [
        "string",
        "null"
      ],
      "description": "EDGAR acceptanceDateTime of the results filing (ISO 8601 with a time zone, or EDGAR's YYYYMMDDHHMMSS)"
    },
    "accession": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
    },
    "merged_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the items file was merged into the default branch (taken from GitHub, with a time zone)"
    },
    "ots_proof": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path of the OpenTimestamps proof (prereg/<period>.yml.ots)"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9.]*-FY\\d{4}Q[1-4]-\\d+$"
        },
        "outcome": {
          "enum": [
            "happened",
            "not_happened",
            "undetermined"
          ]
        },
        "values": {
          "type": [
            "object",
            "array",
            "number",
            "string",
            "null"
          ],
          "description": "The values used"
        },
        "calculation": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "description": "A quotation of at most one sentence from the original text, with its source tag"
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
              "description": "Source tag, TAG or TAG#LOCATOR"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ],
          "description": "Written step by step, following criterion only"
        },
        "settled_at": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            },
            {
              "type": "null"
            }
          ]
        },
        "hq_ruling": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "HQ's ruling when the criterion is ambiguous"
        }
      },
      "additionalProperties": false
    }
  }
}
