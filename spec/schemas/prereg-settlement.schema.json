{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/prereg-settlement.schema.json",
  "title": "预注册结算 prereg/<期间>.settlement.yml（流水线维护）",
  "type": "object",
  "required": [
    "company",
    "period",
    "results"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "period": {
      "type": "string",
      "pattern": "^FY\\d{4}Q[1-4]$",
      "description": "按公司财年写的期间 FY<年>Q<季>"
    },
    "acceptance_datetime": {
      "type": [
        "string",
        "null"
      ],
      "description": "业绩文件的 EDGAR acceptanceDateTime（ISO 8601 含时区，或 EDGAR 的 YYYYMMDDHHMMSS）"
    },
    "accession": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
    },
    "merged_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "条目文件合并进默认分支的时间（取自 GitHub，含时区）"
    },
    "ots_proof": {
      "type": [
        "string",
        "null"
      ],
      "description": "OpenTimestamps 证明文件路径（prereg/<期间>.yml.ots）"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9.]*-FY\\d{4}Q[1-4]-\\d+$"
        },
        "outcome": {
          "enum": [
            "happened",
            "not_happened",
            "undetermined"
          ]
        },
        "values": {
          "type": [
            "object",
            "array",
            "number",
            "string",
            "null"
          ],
          "description": "用到的数值"
        },
        "calculation": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "description": "一句以内的原文摘录与来源标签"
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
              "description": "来源标签，TAG 或 TAG#LOCATOR"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ],
          "description": "只按 criterion 一步一步写"
        },
        "settled_at": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}"
            },
            {
              "type": "null"
            }
          ]
        },
        "hq_ruling": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "判定标准有歧义时总部的裁定"
        }
      },
      "additionalProperties": false
    }
  }
}
