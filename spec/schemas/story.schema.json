{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/story.schema.json",
  "title": "两分钟故事 story.md 的 front matter",
  "type": "object",
  "required": [
    "company",
    "as_of",
    "status"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "holding",
        "candidate",
        "archive"
      ]
    },
    "category": {
      "enum": [
        "slow_grower",
        "stalwart",
        "fast_grower",
        "cyclical",
        "turnaround",
        "asset_play"
      ]
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
