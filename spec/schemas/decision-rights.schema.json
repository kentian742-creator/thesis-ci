{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/decision-rights.schema.json",
  "title": "Three decision levels and trust levels decision-rights.yml",
  "type": "object",
  "required": [
    "levels",
    "trust",
    "memo",
    "portfolio",
    "ranking",
    "budget",
    "phase_gate"
  ],
  "properties": {
    "levels": {
      "type": "object",
      "required": [
        "L1",
        "L2",
        "L3"
      ],
      "properties": {
        "L1": {
          "type": "object",
          "required": [
            "who",
            "actions",
            "report"
          ],
          "properties": {
            "who": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "enum": [
                  "fetch",
                  "parse",
                  "draft",
                  "test",
                  "audit",
                  "blind_read",
                  "routine_merge",
                  "fact_revision",
                  "signpost_check",
                  "prereg_content",
                  "scenario_probability",
                  "test_warning_disposition",
                  "candidate_rotation",
                  "model_selection",
                  "publish",
                  "valuation_update",
                  "prompt_change",
                  "buy",
                  "add",
                  "trim",
                  "sell",
                  "amend_constitution"
                ]
              },
              "uniqueItems": true
            },
            "report": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "L2": {
          "type": "object",
          "required": [
            "who",
            "actions",
            "report"
          ],
          "properties": {
            "who": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "enum": [
                  "fetch",
                  "parse",
                  "draft",
                  "test",
                  "audit",
                  "blind_read",
                  "routine_merge",
                  "fact_revision",
                  "signpost_check",
                  "prereg_content",
                  "scenario_probability",
                  "test_warning_disposition",
                  "candidate_rotation",
                  "model_selection",
                  "publish",
                  "valuation_update",
                  "prompt_change",
                  "buy",
                  "add",
                  "trim",
                  "sell",
                  "amend_constitution"
                ]
              },
              "uniqueItems": true
            },
            "report": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "L3": {
          "type": "object",
          "required": [
            "who",
            "actions",
            "report"
          ],
          "properties": {
            "who": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "enum": [
                  "fetch",
                  "parse",
                  "draft",
                  "test",
                  "audit",
                  "blind_read",
                  "routine_merge",
                  "fact_revision",
                  "signpost_check",
                  "prereg_content",
                  "scenario_probability",
                  "test_warning_disposition",
                  "candidate_rotation",
                  "model_selection",
                  "publish",
                  "valuation_update",
                  "prompt_change",
                  "buy",
                  "add",
                  "trim",
                  "sell",
                  "amend_constitution"
                ]
              },
              "uniqueItems": true
            },
            "report": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "required": [
        "levels",
        "initial",
        "window",
        "downgrade",
        "upgrade",
        "routing"
      ],
      "properties": {
        "levels": {
          "type": "object",
          "properties": {
            "0": {
              "type": "string"
            },
            "1": {
              "type": "string"
            },
            "2": {
              "type": "string"
            },
            "3": {
              "type": "string"
            }
          },
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false
        },
        "initial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "window": {
          "type": "integer",
          "minimum": 1
        },
        "downgrade": {
          "type": "object"
        },
        "upgrade": {
          "type": "object"
        },
        "routing": {
          "type": "object",
          "description": "Routing by trust level (§G9): 3 auto-merge and publish; 2 auto-merge, reviewed by HQ before publishing; 1 kept in the private repository first; 0 autonomy paused",
          "properties": {
            "0": {
              "type": "string"
            },
            "1": {
              "type": "string"
            },
            "2": {
              "type": "string"
            },
            "3": {
              "type": "string"
            }
          },
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false
        },
        "scoring": {
          "type": "object",
          "description": "How trust levels are scored: fact errors, divergence rulings, which output of whom counts as one update"
        }
      },
      "additionalProperties": false
    },
    "memo": {
      "type": "object",
      "required": [
        "default_option",
        "timeout_days",
        "monthly_target_max"
      ],
      "properties": {
        "default_option": {
          "const": "maintain"
        },
        "timeout_days": {
          "type": "integer",
          "minimum": 1
        },
        "monthly_target_max": {
          "type": "integer",
          "minimum": 0
        },
        "sell_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_sell_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "portfolio": {
      "type": "object",
      "required": [
        "max_holdings",
        "entry_band"
      ],
      "properties": {
        "max_holdings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "entry_band": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "single_order_entry": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ranking": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "The clause the ranking follows, e.g. §V13 (no mechanical sort by a single metric)"
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "rotation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "description": "Release gates (the gate_rules of 17A)"
    },
    "budget": {
      "type": "object",
      "required": [
        "monthly_usd",
        "degrade_order"
      ],
      "properties": {
        "monthly_usd": {
          "type": "number"
        },
        "degrade_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "phase_gate": {
      "type": "object"
    },
    "escalation": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
