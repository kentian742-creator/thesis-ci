{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/repo.schema.json",
  "title": "档案仓库标记 repo.yml",
  "type": "object",
  "required": [
    "visibility",
    "spec_version"
  ],
  "properties": {
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "owner": {
      "type": "string"
    },
    "spec_version": {
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "档案遵循的规范版本；0.1 只在迁移期接受（C-SCHEMA 报警告）"
    },
    "counterpart": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
