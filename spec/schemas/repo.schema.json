{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/repo.schema.json",
  "title": "Archive repository marker repo.yml",
  "type": "object",
  "required": [
    "visibility",
    "spec_version"
  ],
  "properties": {
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "owner": {
      "type": "string"
    },
    "spec_version": {
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "The specification version the archive follows; 0.1 is accepted only during the migration (C-SCHEMA gives a warning)"
    },
    "counterpart": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
