{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/constitution-rules.schema.json",
  "title": "宪法规则与对应检查 constitution/rules.yml",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(R|H)[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "constitution",
              "hard_rule"
            ]
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C-[A-Z0-9-]+$"
            }
          },
          "how_checked": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
