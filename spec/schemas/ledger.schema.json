{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kentian742-creator/thesis-ci/spec/schemas/ledger.schema.json",
  "title": "双向言行账本 ledger.yml",
  "type": "object",
  "required": [
    "company",
    "entries"
  ],
  "properties": {
    "company": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "side",
          "statement",
          "made_at",
          "due",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "side": {
            "enum": [
              "management",
              "system",
              "owner"
            ]
          },
          "kind": {
            "enum": [
              "numeric_target",
              "capex_plan",
              "buyback",
              "product_timeline",
              "prediction",
              "other"
            ]
          },
          "statement": {
            "type": "string"
          },
          "made_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "due": {
            "oneOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-Q[1-4]|-H[12])?$"
              }
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
            "description": "来源标签，TAG 或 TAG#LOCATOR"
          },
          "status": {
            "enum": [
              "pending",
              "kept",
              "partially_kept",
              "not_kept",
              "silently_dropped",
              "undetermined"
            ]
          },
          "acknowledged_next_letter": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "坦诚度：未兑现是否在下一封信里主动承认"
          },
          "settlement_source": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
                "description": "来源标签，TAG 或 TAG#LOCATOR"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 0.95,
            "description": "系统与所有者一侧必填（§P3）"
          },
          "last_mentioned": {
            "oneOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "管理层最近一次在沟通中提到这条承诺的日期（判断“悄然消失”）"
          },
          "acknowledged_source": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
                "description": "来源标签，TAG 或 TAG#LOCATOR"
              },
              {
                "type": "null"
              }
            ],
            "description": "未兑现时主动承认的出处"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "side": {
                  "enum": [
                    "system",
                    "owner"
                  ]
                }
              },
              "required": [
                "side"
              ]
            },
            "then": {
              "required": [
                "probability"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "kept",
                    "not_kept",
                    "undetermined"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "buybacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "period",
          "avg_price",
          "source"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "avg_price": {
            "type": "number"
          },
          "shares": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Za-z0-9._-]*(#[^\\]\\s]+)?$",
            "description": "来源标签，TAG 或 TAG#LOCATOR"
          },
          "value_range_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "私有 valuation.yml 的版本引用"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
